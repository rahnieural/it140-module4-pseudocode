# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

// Welcome message
OUTPUT "Welcome to the Higher/Lower game, Bella!"

// Get lower and upper bounds with validation
OUTPUT "Enter the lower bound:"
INPUT lowerBound
OUTPUT "Enter the upper bound:"
INPUT upperBound

WHILE lowerBound >= upperBound
    OUTPUT "The lower bound must be less than the upper bound."
    OUTPUT "Enter the lower bound:"
    INPUT lowerBound
    OUTPUT "Enter the upper bound:"
    INPUT upperBound
ENDWHILE

// Generate random target number
secretNumber = RANDOM_INT(lowerBound, upperBound)

// Game loop for guesses
guessedCorrectly = FALSE

// First guess prompt
OUTPUT "Great, now guess a number between ", lowerBound, " and ", upperBound, ":"[cite: 8]
INPUT userGuess

WHILE guessedCorrectly == FALSE
    // Decision branching
    IF userGuess < secretNumber THEN
        OUTPUT "Nope, too low."[cite: 8]
    ELSE IF userGuess > secretNumber THEN
        OUTPUT "Nope, too high."[cite: 8]
    ELSE
        OUTPUT "You got it!"[cite: 8]
        guessedCorrectly = TRUE
    ENDIF

    // If not guessed correctly, prompt for the next guess
    IF guessedCorrectly == FALSE THEN
        OUTPUT "Guess another number:"[cite: 8]
        INPUT userGuess
    ENDIF
ENDWHILE

END hilow_game

